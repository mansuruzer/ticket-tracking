# ---- Veri kaynağı --------------------------------------------------------
# mock = demo veri (anahtarsız denemek için) | travelpayouts = gerçek fiyatlar
UG_PROVIDER=travelpayouts
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=tr
TRAVELPAYOUTS_RATE_PER_MIN=50

# Para birimi ve kara yolu tahmini için 1 EUR kaç TL (arada bir güncelle)
UG_CURRENCY=try
UG_EUR_RATE=54

# ---- İsteğe bağlı canlı doğrulama (en iyi N sonucu gerçek zamanlı kontrol eder)
SERPAPI_KEY=
DUFFEL_TOKEN=
UG_VERIFY_TOP_N=0

# ---- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# ---- Genel ----------------------------------------------------------------
UG_BASE_URL=http://localhost:8000
UG_DB_PATH=ucuzgez.db
UG_WATCH_INTERVAL_MIN=180
UG_RADAR=1
UG_RADAR_HOUR=9
UG_CACHE_TTL_MIN=360
UG_MAX_GROUND_HOURS=6
TZ=Europe/Istanbul
