[Unit]
Description=UcuzGez ucuz bilet bulucu (web + Telegram + zamanlayıcı)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python -m ucuzgez
Restart=always
RestartSec=10
MemoryMax=600M

[Install]
WantedBy=multi-user.target
